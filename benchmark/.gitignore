# Virtual environment
.venv/
__pycache__/
*.pyc

# Local credentials (keep .env.example tracked)
.env

# Evaluation outputs — whole results tree (run_*/<strategy>/metrics.csv + answers.md)
**/results/

# Local run configs (config.full.yaml, config.smoke.yaml, ...). The shared one
# is `config.yaml` and stays tracked; these are per-machine variants naming
# collections and datasets that only exist locally. `git add -f` to share one.
config.*.yaml
