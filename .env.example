# LLM (Mistral 24B) — OpenAI-compatible
MISTRAL_API_BASE=https://your-mistral-host/v1
MISTRAL_API_KEY=changeme
MISTRAL_MODEL=mistral-24b-instruct

# Embeddings (Gemma2 multilingual) — OpenAI-compatible
EMBED_API_BASE=https://your-embeddings-host/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-multilingual-gemma2
# Optional sparse retrieval model, used only by sparse retrieval profiles.
FASTEMBED_SPARSE_MODEL=Qdrant/bm25

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# comma-separated list of collections (first is default current)
QDRANT_COLLECTIONS=utilitr_v1
# Optional Qdrant named sparse vector. Leave empty for the default sparse vector.
QDRANT_SPARSE_VECTOR_NAME=

# App
DB_POSTGRES_URL=postgresql+psycopg://user-name:password@base-url:5432/canar
